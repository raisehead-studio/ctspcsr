{"pageProps":{"data":{"news_id":"905","news_catgory":"0","hot_news":"0","news_push":"","news_on_top":"1","news_title":"避免漂綠 金管會2021年將推綠色金融統一定義","news_summary":"","image_path":"","news_content":"<p style=\\\"box-sizing: border-box; margin: 0px 0px 30px; display: block; margin-block-start: 0.1em; margin-block-end: 0.1em; margin-inline-start: 0px; margin-inline-end: 0px; color: rgb(102, 102, 102); font-family: 微軟正黑體, &quot;Microsoft JhengHei&quot;; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-style: initial; text-decoration-color: initial;\\\"><span style=\\\"box-sizing: border-box; font-size: 16px;\\\">21:18&nbsp; 2020/08/18 &nbsp;工商 &nbsp;彭禎伶、魏喬怡</span></p>\r\n\r\n<p style=\\\"box-sizing: border-box; margin: 0px 0px 30px; display: block; margin-block-start: 0.1em; margin-block-end: 0.1em; margin-inline-start: 0px; margin-inline-end: 0px; color: rgb(102, 102, 102); font-family: 微軟正黑體, &quot;Microsoft JhengHei&quot;; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-style: initial; text-decoration-color: initial;\\\">&nbsp;</p>\r\n\r\n<p style=\\\"box-sizing: border-box; margin: 0px 0px 30px; display: block; margin-block-start: 0.1em; margin-block-end: 0.1em; margin-inline-start: 0px; margin-inline-end: 0px; color: rgb(102, 102, 102); font-family: 微軟正黑體, &quot;Microsoft JhengHei&quot;; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-style: initial; text-decoration-color: initial;\\\"><span style=\\\"box-sizing: border-box; font-size: 16px;\\\"><img alt=\\\"\\\" src=\\\"http://www.stspcsr.com.tw/user_files/news_files/%E9%87%91%E7%AE%A1%E6%9C%83%E4%B8%BB%E5%A7%94.jpg\\\" style=\\\"border: 0px; border-image: none; width: 80%; vertical-align: middle; box-sizing: border-box;\\\" /></span></p>\r\n\r\n<p style=\\\"box-sizing: border-box; margin: 0px 0px 30px; display: block; margin-block-start: 0.1em; margin-block-end: 0.1em; margin-inline-start: 0px; margin-inline-end: 0px; color: rgb(102, 102, 102); font-family: 微軟正黑體, &quot;Microsoft JhengHei&quot;; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-style: initial; text-decoration-color: initial;\\\">&nbsp;</p>\r\n\r\n<p style=\\\"box-sizing: border-box; margin: 0px 0px 30px; display: block; margin-block-start: 0.1em; margin-block-end: 0.1em; margin-inline-start: 0px; margin-inline-end: 0px; color: rgb(102, 102, 102); font-family: 微軟正黑體, &quot;Microsoft JhengHei&quot;; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-style: initial; text-decoration-color: initial;\\\"><span style=\\\"box-sizing: border-box; font-size: 16px;\\\">（金管會主委黃天牧親自宣示台灣推動綠色金融的決心，要讓世界看見。圖／魏喬怡）</span></p>\r\n\r\n<p style=\\\"box-sizing: border-box; margin: 0px 0px 30px; display: block; margin-block-start: 0.1em; margin-block-end: 0.1em; margin-inline-start: 0px; margin-inline-end: 0px; color: rgb(102, 102, 102); font-family: 微軟正黑體, &quot;Microsoft JhengHei&quot;; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-style: initial; text-decoration-color: initial;\\\">&nbsp;</p>\r\n\r\n<hr style=\\\"box-sizing: content-box; height: 1px; margin-top: 20px; margin-bottom: 20px; border: 0px; background-image: -webkit-linear-gradient(left, transparent, rgba(0, 0, 0, 0.2), transparent); color: rgb(102, 102, 102); font-family: 微軟正黑體, &quot;Microsoft JhengHei&quot;; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-style: initial; text-decoration-color: initial;\\\" />\r\n<p style=\\\"box-sizing: border-box; margin: 0px 0px 30px; display: block; margin-block-start: 0.1em; margin-block-end: 0.1em; margin-inline-start: 0px; margin-inline-end: 0px; color: rgb(102, 102, 102); font-family: 微軟正黑體, &quot;Microsoft JhengHei&quot;; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-style: initial; text-decoration-color: initial; text-align: justify;\\\">&nbsp;</p>\r\n\r\n<p style=\\\"box-sizing: border-box; margin: 0px 0px 30px; display: block; margin-block-start: 0.1em; margin-block-end: 0.1em; margin-inline-start: 0px; margin-inline-end: 0px; color: rgb(102, 102, 102); font-family: 微軟正黑體, &quot;Microsoft JhengHei&quot;; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-style: initial; text-decoration-color: initial; text-align: justify;\\\"><span style=\\\"box-sizing: border-box; font-size: 18px;\\\">避免金融業「漂綠」混充業績，金管會2021年底前將訂出統一的綠色金融定義，並推出永續金融數據整合平台，金管會主委黃天牧表示，全球都在訂綠色金融的共同定義，避免漂綠（Green Wash），台灣並不落後，未來訂出統一定義後，「更能得到國際的肯定與認識」。</span></p>\r\n\r\n<p style=\\\"box-sizing: border-box; margin: 0px 0px 30px; display: block; margin-block-start: 0.1em; margin-block-end: 0.1em; margin-inline-start: 0px; margin-inline-end: 0px; color: rgb(102, 102, 102); font-family: 微軟正黑體, &quot;Microsoft JhengHei&quot;; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-style: initial; text-decoration-color: initial; text-align: justify;\\\">&nbsp;</p>\r\n\r\n<p style=\\\"box-sizing: border-box; margin: 0px 0px 30px; display: block; margin-block-start: 0.1em; margin-block-end: 0.1em; margin-inline-start: 0px; margin-inline-end: 0px; color: rgb(102, 102, 102); font-family: 微軟正黑體, &quot;Microsoft JhengHei&quot;; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-style: initial; text-decoration-color: initial; text-align: justify;\\\"><span style=\\\"box-sizing: border-box; font-size: 18px;\\\">黃天牧18日親自主持記者會公布綠色金融2.0方案，強調此舉動是要宣示台灣的企圖心，且其實台灣業者作了很多綠色金融、永續金融的努力，但因為沒有用英文向國際傳達、也沒有統一的定義或用國際規格揭露，這次金管會站在「浪頭」上宣誓，就是要強調及創造氛圍，讓台灣在永續金融上能與世界各國並駕齊趨。</span></p>\r\n\r\n<p style=\\\"box-sizing: border-box; margin: 0px 0px 30px; display: block; margin-block-start: 0.1em; margin-block-end: 0.1em; margin-inline-start: 0px; margin-inline-end: 0px; color: rgb(102, 102, 102); font-family: 微軟正黑體, &quot;Microsoft JhengHei&quot;; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-style: initial; text-decoration-color: initial; text-align: justify;\\\">&nbsp;</p>\r\n\r\n<p style=\\\"box-sizing: border-box; margin: 0px 0px 30px; display: block; margin-block-start: 0.1em; margin-block-end: 0.1em; margin-inline-start: 0px; margin-inline-end: 0px; color: rgb(102, 102, 102); font-family: 微軟正黑體, &quot;Microsoft JhengHei&quot;; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-style: initial; text-decoration-color: initial; text-align: justify;\\\"><span style=\\\"box-sizing: border-box; font-size: 18px;\\\">金管會指出，歐盟積極討論綠色或永續金融，如英國即認為有優勢可發展Green Hub（綠色金融中心），另外如馬來西亞、盧森堡亦很積極，台灣已有綠色債券，未來會有可持續債、社會債券發行，推出永續板，且在金融及資本市場方面，會有綠色信用卡、綠色股票、綠色債券指數、綠色基金、綠色保單等續推出。</span></p>\r\n\r\n<p style=\\\"box-sizing: border-box; margin: 0px 0px 30px; display: block; margin-block-start: 0.1em; margin-block-end: 0.1em; margin-inline-start: 0px; margin-inline-end: 0px; color: rgb(102, 102, 102); font-family: 微軟正黑體, &quot;Microsoft JhengHei&quot;; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-style: initial; text-decoration-color: initial; text-align: justify;\\\">&nbsp;</p>\r\n\r\n<p style=\\\"box-sizing: border-box; margin: 0px 0px 30px; display: block; margin-block-start: 0.1em; margin-block-end: 0.1em; margin-inline-start: 0px; margin-inline-end: 0px; color: rgb(102, 102, 102); font-family: 微軟正黑體, &quot;Microsoft JhengHei&quot;; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-style: initial; text-decoration-color: initial; text-align: justify;\\\"><span style=\\\"box-sizing: border-box; font-size: 18px;\\\">黃天牧表示，綠色金融1.0是強調金融機構以投資、融資去支持綠能產業，但綠色金融2.0會強調資訊揭露，且是支持綠色及永續發展產業，會更為深化，且形塑一個更有影響力的氛圍，「做，絕對會比不做更進步」。</span></p>\r\n\r\n<p style=\\\"box-sizing: border-box; margin: 0px 0px 30px; display: block; margin-block-start: 0.1em; margin-block-end: 0.1em; margin-inline-start: 0px; margin-inline-end: 0px; color: rgb(102, 102, 102); font-family: 微軟正黑體, &quot;Microsoft JhengHei&quot;; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-style: initial; text-decoration-color: initial; text-align: justify;\\\">&nbsp;</p>\r\n\r\n<p style=\\\"box-sizing: border-box; margin: 0px 0px 30px; display: block; margin-block-start: 0.1em; margin-block-end: 0.1em; margin-inline-start: 0px; margin-inline-end: 0px; color: rgb(102, 102, 102); font-family: 微軟正黑體, &quot;Microsoft JhengHei&quot;; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-style: initial; text-decoration-color: initial; text-align: justify;\\\"><span style=\\\"box-sizing: border-box; font-size: 18px;\\\">金管會指出，綠色產業即包含綠能、綠色交通、綠建築等，永續金融即ESG，包括環境永續、社會永續、良好公司治理，全球的趨勢是要逐步淘汰高碳排的企業，屆時這些公司資金就會吃緊，銀行授信也可能無法確保，授信風險提升，此時銀行可有二項作法，一是避開這樣的公司，二是可以說服此企企業重視ESG。</span></p>\r\n\r\n<p style=\\\"box-sizing: border-box; margin: 0px 0px 30px; display: block; margin-block-start: 0.1em; margin-block-end: 0.1em; margin-inline-start: 0px; margin-inline-end: 0px; color: rgb(102, 102, 102); font-family: 微軟正黑體, &quot;Microsoft JhengHei&quot;; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-style: initial; text-decoration-color: initial; text-align: justify;\\\">&nbsp;</p>\r\n\r\n<p style=\\\"box-sizing: border-box; margin: 0px 0px 30px; display: block; margin-block-start: 0.1em; margin-block-end: 0.1em; margin-inline-start: 0px; margin-inline-end: 0px; color: rgb(102, 102, 102); font-family: 微軟正黑體, &quot;Microsoft JhengHei&quot;; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-style: initial; text-decoration-color: initial; text-align: justify;\\\"><span style=\\\"box-sizing: border-box; font-size: 18px;\\\">綠色金融將推動四大重點，一是界定永續金融涵蓋內容及分類，二是建立ESG資訊整合平台及資料庫，若台灣沒有永續金融數據整合平台，國外退休基金等投資人就不會看見台灣；三是強化ESG資訊揭露質量，更多上市櫃公司揭露ESG資訊，並建立資訊整合平台，資訊要有可比較性，且CSR（企業社會責任報告）應取得第三方認證，提升品質，四是加強金融機構因應氣候變遷風險，由董事會及管理階層向下推動。</span></p>\r\n\r\n<p style=\\\"box-sizing: border-box; margin: 0px 0px 30px; display: block; margin-block-start: 0.1em; margin-block-end: 0.1em; margin-inline-start: 0px; margin-inline-end: 0px; color: rgb(102, 102, 102); font-family: 微軟正黑體, &quot;Microsoft JhengHei&quot;; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-style: initial; text-decoration-color: initial; text-align: justify;\\\">&nbsp;</p>\r\n\r\n<p style=\\\"box-sizing: border-box; margin: 0px 0px 30px; display: block; margin-block-start: 0.1em; margin-block-end: 0.1em; margin-inline-start: 0px; margin-inline-end: 0px; color: rgb(102, 102, 102); font-family: 微軟正黑體, &quot;Microsoft JhengHei&quot;; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-style: initial; text-decoration-color: initial; text-align: justify;\\\"><span style=\\\"box-sizing: border-box; font-size: 18px;\\\">今年底所有銀行就會被要求公布CSR報告，且要有第三方認證，增加可信度，2021年6月是一定規模以上券商、資產1兆元以上的八家壽險公司，與資產規模前五大的產險公司比照揭露。(工商 )</span></p>\r\n\r\n<p style=\\\"box-sizing: border-box; margin: 0px 0px 30px; display: block; margin-block-start: 0.1em; margin-block-end: 0.1em; margin-inline-start: 0px; margin-inline-end: 0px; color: rgb(102, 102, 102); font-family: 微軟正黑體, &quot;Microsoft JhengHei&quot;; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-style: initial; text-decoration-color: initial; text-align: justify;\\\">&nbsp;</p>\r\n\r\n<p style=\\\"box-sizing: border-box; margin: 0px 0px 30px; display: block; margin-block-start: 0.1em; margin-block-end: 0.1em; margin-inline-start: 0px; margin-inline-end: 0px; color: rgb(102, 102, 102); font-family: 微軟正黑體, &quot;Microsoft JhengHei&quot;; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-style: initial; text-decoration-color: initial;\\\"><span style=\\\"box-sizing: border-box; font-size: 16px;\\\">資料來源：https://www.chinatimes.com/realtimenews/20200818005367-260410?chdtv</span></p>\r\n\r\n<p style=\\\"box-sizing: border-box; margin: 0px 0px 30px; display: block; margin-block-start: 0.1em; margin-block-end: 0.1em; margin-inline-start: 0px; margin-inline-end: 0px; color: rgb(102, 102, 102); font-family: 微軟正黑體, &quot;Microsoft JhengHei&quot;; font-size: 14px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; background-color: rgb(255, 255, 255); text-decoration-style: initial; text-decoration-color: initial;\\\">&nbsp;</p>\r\n","keyword":"","news_order_id":"0","create_date":"2020-08-21","clk_count":"132"}},"__N_SSG":true}